/dts-v1/;

/ {
	model = "mayhem-kat-board";
	compatible = "mayhem,kat", "ti,am335x";
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			clock-frequency = <0x3b9aca00>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		serial@44e09000 {
			compatible = "ti,am3352-uart";
			reg = <0x44e09000 0x2000>;
			interrupts = <0x48>;
			interrupt-parent = <0x01>;
			rts-gpios = <0x01 0x05 0x00>;
			status = "okay";
		};

		gpio@44e07000 {
			compatible = "ti,omap4-gpio";
			gpio-controller;
			#gpio-cells = <0x02>;
			reg = <0x44e07000 0x1000>;
			phandle = <0x01>;
		};
	};
};
